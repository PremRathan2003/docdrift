# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Matches docker-compose.yml (local only)
DATABASE_URL=postgresql://docdrift:docdrift_local_only@localhost:5432/docdrift?schema=public

# The web app's origin; used for CORS. In production this is your Vercel URL.
WEB_ORIGIN=http://localhost:5173

# Separate database for integration tests (its name MUST end in _test — tests wipe it).
DATABASE_URL_TEST=postgresql://docdrift:docdrift_local_only@localhost:5432/docdrift_test?schema=public

# Used to hash session tokens (HMAC). Rotating it logs every user out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# --- GitHub App (docs/GITHUB_APP_SETUP.md). Leave all empty to run without GitHub. ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The .pem file GitHub gave you, base64-encoded on one line:
#   base64 -i ~/.docdrift/docdrift-dev.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY_BASE64=

# --- AI provider (docs/AI_SETUP.md). AI_PROVIDER=none disables analysis. ---
# gemini | openai-compatible (Groq, OpenRouter, Cerebras, OpenAI, local Ollama) | none
AI_PROVIDER=none
AI_API_KEY=
# A model id for your provider (npm run ai:models lists them)
AI_MODEL=
# openai-compatible only: the API base URL, e.g. https://api.groq.com/openai/v1
# AI_BASE_URL=
# Send the output schema to the provider natively. It stops the model from
# writing malformed JSON, but every model accepts a different subset of JSON
# Schema: run `npm run ai:diagnose` first and turn this on only if it passes.
# AI_NATIVE_SCHEMA=false
# AI_TIMEOUT_MS=90000
# AI_MAX_INPUT_TOKENS=30000
# Output limit per call incl. reasoning; lower it (e.g. 6000) on Groq's free tier
# AI_MAX_OUTPUT_TOKENS=16384
# Optional: USD prices per 1M tokens from the provider's pricing page. Without them
# DocDrift records token counts but no cost (it never guesses a price).
# AI_INPUT_USD_PER_MTOK=
# AI_OUTPUT_USD_PER_MTOK=

# --- Added in later milestones (leave empty for now) ---
# GITHUB_WEBHOOK_SECRET=
